{
  "name": "bbdw-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "check": "npm run lint && npm run build && npm test",
    "smoke": "node scripts/smoke.mjs",
    "sentry:upload": "node --env-file-if-exists=.env scripts/upload-sourcemaps.mjs"
  },
  "dependencies": {
    "@sentry/react": "11.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@sentry/cli": "3.8.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4"
  }
}
